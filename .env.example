# Copy to .env and edit:  cp .env.example .env
# docker compose reads .env automatically. Everything here is optional.

# --- ports on your machine ---------------------------------------------------
WEB_PORT=3000
API_PORT=8000
MAILPIT_PORT=8025
# The web search engine (SearXNG) behind the chat's "Search" button.
SEARCH_PORT=8888
# Speech to text (the microphone button): the Whisper model built into the
# speech image. base = quick; small = more accurate, slower. See docs/configuration.md.
WHISPER_MODEL=base
OLLAMA_PORT=11434

# --- the AI model ----------------------------------------------------------------
# `make up` fills these in the first time (it asks you which model), and
# `make model` changes them. See docs/02-run-a-real-model-locally.md.
# Where the model runs: docker-model-runner (Docker Desktop, on your GPU),
# ollama (in a container, CPU only) or ollama-app (the Ollama app, if installed).
MODEL_ENGINE=
# The model's name in that engine (e.g. ai/qwen3-vl:8B or qwen3-vl:4b-instruct),
# or "mock" for a fake model that needs no download:
LOCAL_MODEL=
# Extra containers to start: "ollama" (the model in Docker), "mock" (the fake
# model, matching LLM_MODELS_FILE below), or empty for Docker Model Runner and
# the Ollama app. docker compose reads this one itself.
COMPOSE_PROFILES=mock

# --- which models the app offers ----------------------------------------------
# A file in ./config: models.local.json (written by `make up` for your
# downloaded models), models.mock.json, or models.sagemaker.json (copy it from
# models.sagemaker.example.json and use `make up-aws`).
LLM_MODELS_FILE=models.mock.json
# Or paste a JSON list here instead (wins over LLM_MODELS_FILE):
# LLM_MODELS=[{"id":"mock","name":"Mock","provider":"openai","base_url":"http://mock-llm:8080/v1","model_id":"mock-chat","default":true}]

# --- accounts ---------------------------------------------------------------
# Your email here = you become an admin (/admin/) after verifying it.
ADMIN_EMAILS=
# mandatory | optional | none   (codes arrive in Mailpit: http://localhost:8025)
EMAIL_VERIFICATION=mandatory
# "Sign in with Google": a Web OAuth client id (docs/authentication.md).
# Add http://localhost:3000 AND http://localhost to its Authorized JavaScript origins.
# Used by `make up` and `make backend-dev` (restart them after changing it).
GOOGLE_CLIENT_ID=

# --- AWS (only for docker-compose.aws.yml / make up-aws) -----------------------
AWS_PROFILE=default
AWS_REGION=us-east-1
